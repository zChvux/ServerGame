[Unit]
Description=PVE Log Server (nhan log tran dau, ghi CSV, import MySQL)
After=network.target mysql.service

[Service]
Type=simple
WorkingDirectory=/opt/pve-log-server
ExecStart=/usr/bin/java -jar /opt/pve-log-server/pve-log-server-jar-with-dependencies.jar
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
